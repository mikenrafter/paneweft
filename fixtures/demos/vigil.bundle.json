      "data": {
        "excerpt": {
          "id": "x-cancel-guard",
          "label": "run_keepalive after the engine returns: flush, cancel checks, commit (src/mcp.rs:155-185)",
          "anchor": {
            "repository": "vigil",
            "path": "src/mcp.rs",
            "lines": [
              155,
