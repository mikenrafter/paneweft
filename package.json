{
  "name": "paneweft",
  "version": "0.0.0",
  "private": true,
  "description": "Portable moldable-development views: schema-first components that agents fill with facts, rendered locally and summarised in bounded text over CLI and MCP.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "paneweft": "./src/cli/bin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:viewer": "node scripts/build-viewer.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
