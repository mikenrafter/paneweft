{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paneweft:schema:tool:validate:1",
  "title": "validate",
  "description": "Validate an envelope or bundle. Returns valid, or errors with code, JSON pointer, constraint and repair hint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input"
  ],
  "properties": {
    "input": {
      "type": "object",
      "description": "An envelope (paneweft.view/1) or bundle (paneweft.bundle/1)."
    },
    "format": {
      "enum": [
        "text",
        "json"
      ],
      "default": "text",
      "description": "Reply format."
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 2048,
      "maximum": 32768,
      "default": 8192,
      "description": "UTF-8 byte budget of the whole serialized reply (design section 4)."
    }
  }
}
