{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paneweft:schema:tool:search:1",
  "title": "search",
  "description": "Search submitted entities, view titles and questions, examples and notebook claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "snapshotId"
      ],
      "properties": {
        "entity": {
          "$ref": "urn:paneweft:schema:common:1#/$defs/EntityRef"
        },
        "snapshotId": {
          "$ref": "urn:paneweft:schema:common:1#/$defs/Id"
        }
      }
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Continuation cursor from a previous reply of the same query."
    },
    "format": {
      "enum": [
        "text",
        "json"
      ],
      "default": "text",
      "description": "Reply format."
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 2048,
      "maximum": 32768,
      "default": 8192,
      "description": "UTF-8 byte budget of the whole serialized reply (design section 4)."
    }
  }
}
