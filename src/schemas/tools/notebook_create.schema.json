{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paneweft:schema:tool:notebook_create:1",
  "title": "notebook_create",
  "description": "Create a notebook page (revision 1) from a notebook envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input"
  ],
  "properties": {
    "input": {
      "type": "object",
      "description": "A notebook envelope."
    },
    "format": {
      "enum": [
        "text",
        "json"
      ],
      "default": "text",
      "description": "Reply format."
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 2048,
      "maximum": 32768,
      "default": 8192,
      "description": "UTF-8 byte budget of the whole serialized reply (design section 4)."
    }
  }
}
