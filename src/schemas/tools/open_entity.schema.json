{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paneweft:schema:tool:open_entity:1",
  "title": "open_entity",
  "description": "Open an entity at a snapshot: pane state, applicable views and a bounded answer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotId",
    "entity"
  ],
  "properties": {
    "snapshotId": {
      "$ref": "urn:paneweft:schema:common:1#/$defs/Id"
    },
    "entity": {
      "$ref": "urn:paneweft:schema:common:1#/$defs/EntityRef"
    },
    "preferredViewDefinitionId": {
      "$ref": "urn:paneweft:schema:common:1#/$defs/Id"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Continuation cursor from a previous reply of the same query."
    },
    "format": {
      "enum": [
        "text",
        "json"
      ],
      "default": "text",
      "description": "Reply format."
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 2048,
      "maximum": 32768,
      "default": 8192,
      "description": "UTF-8 byte budget of the whole serialized reply (design section 4)."
    }
  }
}
