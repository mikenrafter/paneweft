{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paneweft:schema:tool:list_components:1",
  "title": "list_components",
  "description": "List supported component ids with their one-line questions.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Continuation cursor from a previous reply of the same query."
    },
    "format": {
      "enum": [
        "text",
        "json"
      ],
      "default": "text",
      "description": "Reply format."
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 2048,
      "maximum": 32768,
      "default": 8192,
      "description": "UTF-8 byte budget of the whole serialized reply (design section 4)."
    }
  }
}
