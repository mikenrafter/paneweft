{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paneweft:schema:common:1",
  "title": "paneweft common definitions",
  "description": "Shared scalar, anchor, entity-reference, source, item and completeness definitions (design section 2, 'Shared item notation', and section 4).",
  "$defs": {
    "Id": { "type": "string", "minLength": 1, "maxLength": 128, "x-hint": "Use a non-empty opaque string of at most 128 characters." },
    "Label": { "type": "string", "minLength": 1, "maxLength": 256, "x-hint": "Use a non-empty label of at most 256 characters." },
    "ShortText": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "Text": { "type": "string", "maxLength": 65536 },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "x-hint": "Use the lowercase 64-character hexadecimal SHA-256 digest of the inspected bytes."
    },
    "Provenance": {
      "enum": ["read", "parsed", "compiled", "observed", "inferred"],
      "x-hint": "Use one of: read, parsed, compiled, observed, inferred."
    },
    "Scalar": { "type": ["string", "number", "boolean", "null"], "maxLength": 65536 },
    "Kind": {
      "type": "string",
      "pattern": "^(\\*|[a-z][a-z0-9_-]*(/[a-z][a-z0-9_.-]*)*)$",
      "maxLength": 128,
      "x-hint": "Use a lowercase namespaced kind such as 'vigil/watch' or 'code/module'."
    },
    "Anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "lines"],
      "properties": {
        "repository": { "$ref": "#/$defs/Id" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 },
          "x-hint": "Use [first, last], one-based and inclusive."
        }
      }
    },
    "EntityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "id", "kind"],
      "properties": {
        "repository": { "$ref": "#/$defs/Id" },
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "$ref": "#/$defs/Kind" }
      }
    },
    "Column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "format"],
      "properties": {
        "key": { "$ref": "#/$defs/Id" },
        "title": { "$ref": "#/$defs/Label" },
        "format": { "enum": ["text", "number", "boolean"], "x-hint": "Use one of: text, number, boolean." }
      }
    },
    "Cells": {
      "type": "object",
      "propertyNames": { "maxLength": 128 },
      "additionalProperties": { "$ref": "#/$defs/Scalar" }
    },
    "Item": {
      "type": "object",
      "required": ["id", "evidence", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": { "$ref": "#/$defs/Label" },
        "anchor": { "$ref": "#/$defs/Anchor" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/Id" },
          "x-hint": "List the ids of envelope sources that support this item; at least one."
        },
        "entity": { "$ref": "#/$defs/EntityRef" },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "reason": { "$ref": "#/$defs/ShortText" },
        "basis": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/Id" } }
      },
      "if": { "type": "object", "required": ["provenance"], "properties": { "provenance": { "const": "inferred" } } },
      "then": {
        "type": "object",
        "required": ["reason", "basis"],
        "x-hint": "An inferred item needs 'reason' (why) and 'basis' (ids of supporting items or sources)."
      },
      "else": {
        "type": "object",
        "properties": { "reason": false, "basis": false },
        "x-hint": "Only inferred items carry 'reason' and 'basis'; remove them or set provenance to 'inferred'."
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sha256", "capturedAt", "method"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "enum": ["file", "command", "log", "document"], "x-hint": "Use one of: file, command, log, document." },
        "repository": { "$ref": "#/$defs/Id" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://",
          "x-hint": "Only http: and https: URLs are accepted."
        },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "method": { "$ref": "#/$defs/ShortText" },
        "runId": { "$ref": "#/$defs/Id" },
        "argv": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 4096 } },
        "exitCode": { "type": "integer" }
      },
      "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "file" } } },
      "then": { "type": "object", "required": ["repository", "path"], "x-hint": "A file source needs 'repository' and 'path'." }
    },
    "Completeness": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unsupported"], "x-hint": "Use one of: complete, partial, unsupported." },
        "criterion": { "$ref": "#/$defs/ShortText" },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "x-hint": "A partial view must name at least one gap {id, question, reason}.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "question", "reason"],
            "properties": {
              "id": { "$ref": "#/$defs/Id" },
              "question": { "$ref": "#/$defs/ShortText" },
              "reason": { "$ref": "#/$defs/ShortText" }
            }
          }
        },
        "reason": { "$ref": "#/$defs/ShortText" },
        "missingCapabilities": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/Id" } }
      },
      "allOf": [
        {
          "if": { "type": "object", "required": ["status"], "properties": { "status": { "const": "complete" } } },
          "then": {
            "type": "object",
            "required": ["criterion"],
            "properties": { "gaps": false, "reason": false, "missingCapabilities": false },
            "x-hint": "A complete view must name its enumeration criterion, e.g. 'all direct imports in the six listed files'."
          }
        },
        {
          "if": { "type": "object", "required": ["status"], "properties": { "status": { "const": "partial" } } },
          "then": {
            "type": "object",
            "required": ["gaps"],
            "properties": { "criterion": false, "reason": false, "missingCapabilities": false },
            "x-hint": "A partial view must name at least one gap."
          }
        },
        {
          "if": { "type": "object", "required": ["status"], "properties": { "status": { "const": "unsupported" } } },
          "then": {
            "type": "object",
            "required": ["reason", "missingCapabilities"],
            "properties": { "criterion": false, "gaps": false },
            "x-hint": "An unsupported view needs 'reason' and 'missingCapabilities'."
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
