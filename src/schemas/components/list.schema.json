{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paneweft:schema:component:list:1",
  "title": "List and columned list",
  "description": "Rows of facts with stable ids, optional cells per column, optional grouping, and a stable ordering (design section 2.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["columns", "rows", "order"],
  "properties": {
    "columns": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "urn:paneweft:schema:common:1#/$defs/Column" } },
    "rows": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "urn:paneweft:schema:common:1#/$defs/Item" },
          {
            "type": "object",
            "required": ["cells"],
            "properties": {
              "cells": { "$ref": "urn:paneweft:schema:common:1#/$defs/Cells" },
              "group": { "$ref": "urn:paneweft:schema:common:1#/$defs/Label" },
              "notCaptured": {
                "description": "v1: the object this row points at was not captured (a capture limit was reached); `reason` names the limit. Such a row has no entity to open.",
                "type": "object", "additionalProperties": false, "required": ["reason"],
                "properties": { "reason": { "type": "string", "minLength": 1, "maxLength": 64 } }
              }
            }
          }
        ],
        "type": "object",
        "unevaluatedProperties": false
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "direction"],
      "properties": {
        "key": { "$ref": "urn:paneweft:schema:common:1#/$defs/Id" },
        "direction": { "enum": ["asc", "desc"], "x-hint": "Use 'asc' or 'desc'." }
      }
    }
  }
}
