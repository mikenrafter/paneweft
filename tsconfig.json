{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@paneweft/sdk": ["./packages/paneweft-ts/src/index.ts"],
      "@paneweft/sdk/vitest-reporter": ["./packages/paneweft-ts/src/vitest-reporter.ts"],
      "@paneweft/sdk/vitest": ["./packages/paneweft-ts/src/vitest.ts"]
    }
  },
  "include": ["src", "test", "scripts", "vitest.config.ts", "packages", "fixtures/packages"],
  "exclude": ["fixtures/packages/*/node_modules"]
}
